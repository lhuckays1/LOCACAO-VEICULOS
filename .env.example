PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/frota_crm?schema=public
# Conexão direta para migrações; em ambiente local pode ser igual a DATABASE_URL.
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5432/frota_crm?schema=public
# Gere cada segredo separadamente: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
# Docker Compose: use uma senha sem caracteres reservados de URL.
POSTGRES_PASSWORD=
# Necessários somente para o seed inicial, sem credenciais padrão.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=SUPER ADMINISTRADOR

        const rawTipo = String(
          parsed.tipoCobranca || parsed.billingFrequency || 'SEMANAL'
        ).toUpperCase();

        let billingFrequency = 'SEMANAL';

        if (rawTipo.includes('DIAR') || rawTipo === 'DAILY') {
          billingFrequency = 'DIARIA';
        } else if (rawTipo.includes('SEM') || rawTipo === 'WEEKLY') {
          billingFrequency = 'SEMANAL';
        } else if (
          rawTipo.includes('QUINZ') ||
          rawTipo === 'BIWEEKLY'
        ) {
          billingFrequency = 'QUINZENAL';
        } else if (
          rawTipo.includes('MENS') ||
          rawTipo === 'MONTHLY'

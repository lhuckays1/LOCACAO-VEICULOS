  private normalizeStatus(status: string): string {
    const map: Record<string, string> = {
      DRAFT: 'RASCUNHO',
      SCHEDULED: 'AGENDADA',
      ACTIVE: 'ATIVA',
      COMPLETED: 'FINALIZADA',
      CANCELLED: 'CANCELADA',
      OVERDUE: 'ATRASADA',
      BLOCKED: 'BLOQUEADA',
      RASCUNHO: 'RASCUNHO',
      AGENDADA: 'AGENDADA',
      ATIVA: 'ATIVA',
      FINALIZADA: 'FINALIZADA',
      CANCELADA: 'CANCELADA',
      ATRASADA: 'ATRASADA',
      BLOQUEADA: 'BLOQUEADA',
    };

    return map[String(status).toUpperCase()] || String(status).toUpperCase();
  }

  private toPrismaRentalStatus(status: string): RentalStatus {
    const normalized = this.normalizeStatus(status);

    const map: Record<string, RentalStatus> = {
      RASCUNHO: 'DRAFT',
      AGENDADA: 'SCHEDULED',
      ATIVA: 'ACTIVE',
      FINALIZADA: 'COMPLETED',
      CANCELADA: 'CANCELLED',
      ATRASADA: 'OVERDUE',
      BLOQUEADA: 'BLOCKED',
      DRAFT: 'DRAFT',
      SCHEDULED: 'SCHEDULED',
      ACTIVE: 'ACTIVE',
      COMPLETED: 'COMPLETED',
      CANCELLED: 'CANCELLED',
      OVERDUE: 'OVERDUE',
      BLOCKED: 'BLOCKED',
    };

    return map[normalized] || 'ACTIVE';
  }

  private toPaymentMethod(value?: string | null): PaymentMethod {
    const normalized = String(value || 'PIX')
      .trim()
      .toUpperCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

    const map: Record<string, PaymentMethod> = {
      PIX: 'PIX',
      BOLETO: 'BOLETO',
      CARTAO: 'CARTAO_CREDITO',
      CARTAO_CREDITO: 'CARTAO_CREDITO',
      CARTAO_DEBITO: 'CARTAO_DEBITO',
      CREDITO: 'CARTAO_CREDITO',
      DEBITO: 'CARTAO_DEBITO',
      DINHEIRO: 'DINHEIRO',
      TRANSFERENCIA: 'TRANSFERENCIA',
      TRANSFER: 'TRANSFERENCIA',
      OUTRO: 'OUTRO',
    };

    return map[normalized] || 'PIX';
  }

  private decimalToNumber(value: Prisma.Decimal | number | null | undefined): number {
    if (value === null || value === undefined) return 0;
    return Number(value);
  }

  private formatPayment(payment: any) {
    const transaction = payment.financialTransaction;
    const settlements = transaction?.settlements || [];

    const totalSettled = settlements.reduce(
      (sum: number, settlement: any) =>
        sum + this.decimalToNumber(settlement.amount),
      0
    );

    const paidAmount =
      transaction?.paidAmount !== undefined
        ? this.decimalToNumber(transaction.paidAmount)
        : totalSettled;

    const remainingAmount =
      transaction?.remainingAmount !== undefined
        ? this.decimalToNumber(transaction.remainingAmount)
        : Math.max(0, this.decimalToNumber(payment.valor) - paidAmount);

    return {
      ...payment,
      valor: this.decimalToNumber(payment.valor),
      valorPago: paidAmount,
      saldo: remainingAmount,
      jurosAplicados: this.decimalToNumber(transaction?.interestAmount),
      multaAplicada: settlements.reduce(
        (sum: number, settlement: any) =>
          sum + this.decimalToNumber(settlement.fine),
        0
      ),
      settlements: settlements.map((settlement: any) => ({
        ...settlement,
        amount: this.decimalToNumber(settlement.amount),
        interest: this.decimalToNumber(settlement.interest),
        fine: this.decimalToNumber(settlement.fine),
        discount: this.decimalToNumber(settlement.discount),
      })),
    };
  }

  private getMonthlyMileageControl(rental: any, referenceDate?: Date) {
    const allowance = Math.max(0, Number(rental.mileageAllowance ?? 6000));
    const startDate = new Date(rental.startDate);
    const reference = referenceDate ? new Date(referenceDate) : new Date();

    if (Number.isNaN(startDate.getTime())) {
      return {
        allowance,
        cycleStart: null,
        cycleEnd: null,
        used: 0,
        remaining: allowance,
        excess: 0,
        cycleNumber: 1,
      };
    }

    // A franquia Ã© renovada no aniversÃ¡rio mensal do inÃ­cio da locaÃ§Ã£o.
    // Ex.: inÃ­cio em 27/08 -> ciclos 27/08-26/09, 27/09-26/10 etc.
    let months =
      (reference.getFullYear() - startDate.getFullYear()) * 12 +
      (reference.getMonth() - startDate.getMonth());

    const buildCycleStart = (monthOffset: number) => {
      const result = new Date(startDate);
      const originalDay = startDate.getDate();
      result.setDate(1);
      result.setMonth(result.getMonth() + monthOffset);
      const lastDay = new Date(
        result.getFullYear(),
        result.getMonth() + 1,
        0
      ).getDate();
      result.setDate(Math.min(originalDay, lastDay));
      return result;
    };

    let cycleStart = buildCycleStart(months);
    if (cycleStart > reference) {
      months -= 1;
      cycleStart = buildCycleStart(months);
    }

    const cycleEnd = buildCycleStart(months + 1);
    cycleEnd.setMilliseconds(cycleEnd.getMilliseconds() - 1);

    const logs = Array.isArray(rental.vehicle?.mileageLogs)
      ? rental.vehicle.mileageLogs
      : [];

    const logsBeforeCycle = logs
      .filter((log: any) => {
        const date = new Date(log.date);
        return !Number.isNaN(date.getTime()) && date <= cycleStart;
      })
      .sort((a: any, b: any) =>
        new Date(b.date).getTime() - new Date(a.date).getTime()
      );

    const baseline = Number(
      logsBeforeCycle[0]?.mileage ?? rental.initialMileage ?? 0
    );
    const latestMileageAtReference = logs
      .filter((log: any) => {
        const date = new Date(log.date);
        return !Number.isNaN(date.getTime()) && date <= reference;
      })
      .sort((a: any, b: any) =>
        new Date(b.date).getTime() - new Date(a.date).getTime()
      )[0];

    const currentMileage = rental.actualEndDate
      ? Number(latestMileageAtReference?.mileage ?? rental.finalMileage ?? baseline)
      : Number(rental.vehicle?.currentMileage ?? latestMileageAtReference?.mileage ?? baseline);

    const used = Math.max(0, currentMileage - baseline);
    const remaining = Math.max(0, allowance - used);
    const excess = Math.max(0, used - allowance);

    return {
      allowance,
      cycleStart,
      cycleEnd,
      used,
      remaining,
      excess,
      cycleNumber: Math.max(1, months + 1),
    };
  }

  private formatRental(rental: any, overduePaymentIds: Set<string> = new Set()) {
    const effectiveStatus =
      rental.status === 'ACTIVE' && overduePaymentIds.size > 0
        ? 'ATRASADA'
        : this.normalizeStatus(rental.status);

    const payments = (rental.rentalPayments || []).map((payment: any) =>
      this.formatPayment(payment)
    );

    const totalPaid = payments.reduce(
      (sum: number, payment: any) =>
        sum + Number(payment.valorPago || 0),
      0
    );

    const totalPending = payments
      .filter(
        (payment: any) =>
          payment.status === 'PENDENTE' || payment.status === 'PARCIAL'
      )
      .reduce((sum: number, payment: any) => sum + Number(payment.saldo ?? payment.valor ?? 0), 0);

    const totalOverdue = payments
      .filter((payment: any) => payment.status === 'ATRASADO')
      .reduce((sum: number, payment: any) => sum + Number(payment.saldo ?? payment.valor ?? 0), 0);

    const pendingPayments = payments
      .filter(
        (payment: any) =>
          payment.status === 'PENDENTE' ||
          payment.status === 'ATRASADO' ||
          payment.status === 'PARCIAL'
      )
      .sort((a: any, b: any) =>
        String(a.dataVencimento).localeCompare(String(b.dataVencimento))
      );

    const nextDueDate =
      pendingPayments.length > 0 ? pendingPayments[0].dataVencimento : null;

    return {
      id: rental.id,
      companyId: rental.companyId,
      rentalNumber: rental.rentalNumber,
      codigoContrato: rental.codigoContrato || rental.rentalNumber,

      clientId: rental.clientId,
      clienteId: rental.clientId,
      client: rental.client
        ? {
            id: rental.client.id,
            name: rental.client.name,
            cpfCnpj: rental.client.cpfCnpj,
            phone: rental.client.phone,
            email: rental.client.email,
            driverLicense: rental.client.driverLicense,
            driverLicenseExpiration: rental.client.driverLicenseExpiration,
            active: rental.client.active,
          }
        : null,

      vehicleId: rental.vehicleId,
      veiculoId: rental.vehicleId,
      vehicle: rental.vehicle
        ? {
            id: rental.vehicle.id,
            plate: rental.vehicle.plate,
            brand: rental.vehicle.brand,
            model: rental.vehicle.model,
            year: rental.vehicle.modelYear,
            color: rental.vehicle.color,
            category: rental.vehicle.category,
            currentMileage: rental.vehicle.currentMileage,
          }
        : null,

      // Controle de franquia mensal: o saldo Ã© renovado a cada aniversÃ¡rio
      // da locaÃ§Ã£o e nunca Ã© acumulado para o mÃªs seguinte.
      ...(() => {
        const mileageControl = this.getMonthlyMileageControl(
          rental,
          rental.actualEndDate ? new Date(rental.actualEndDate) : new Date()
        );

        return {
          franquiaKmMensal: mileageControl.allowance,
          kmFranquiaMensal: mileageControl.allowance,
          kmCicloInicio: mileageControl.cycleStart,
          kmCicloFim: mileageControl.cycleEnd,
          kmRodadoCiclo: mileageControl.used,
          kmRestanteCiclo: mileageControl.remaining,
          kmExcedenteCiclo: mileageControl.excess,
          numeroCicloKm: mileageControl.cycleNumber,
        };
      })(),

      startDate: rental.startDate,
      dataInicio: rental.startDate,
      endDate: rental.endDate,
      dataFimPrevista: rental.endDate,
      actualEndDate: rental.actualEndDate,
      dataFimReal: rental.actualEndDate,

      billingFrequency: rental.billingFrequency,
      tipoCobranca: rental.billingFrequency,
      amount: this.decimalToNumber(rental.amount),
      valorPeriodo: this.decimalToNumber(rental.valorPeriodo),
      dueDay: rental.dueDay,
      diaVencimento: rental.dueDay,
      quantidadePeriodos: rental.quantidadePeriodos,

      depositAmount: this.decimalToNumber(rental.depositAmount),
      valorCaucao: this.decimalToNumber(rental.depositAmount),
      caucaoRecebida: this.decimalToNumber(rental.caucaoRecebida),
      statusCaucao: rental.statusCaucao,

      initialMileage: rental.initialMileage,
      kmInicial: rental.initialMileage,
      finalMileage: rental.finalMileage,
      kmFinal: rental.finalMileage,
      mileageAllowance: rental.mileageAllowance,
      franquiaKm: rental.mileageAllowance,
      excessMileageRate: this.decimalToNumber(rental.excessMileageRate),
      valorKmExcedente: this.decimalToNumber(rental.excessMileageRate),

      valorTotalPrevisto: this.decimalToNumber(rental.valorTotalPrevisto),
      desconto: this.decimalToNumber(rental.desconto),
      acrescimos: this.decimalToNumber(rental.acrescimos),
      valorFinal: this.decimalToNumber(rental.valorFinal),

      initialFuelLevel: rental.initialFuelLevel,
      finalFuelLevel: rental.finalFuelLevel,
      status: effectiveStatus,
      statusOriginal: rental.status,
      notes: rental.notes,
      observacoes: rental.notes,

      createdAt: rental.createdAt,
      updatedAt: rental.updatedAt,

      payments,
      inspections: rental.inspections || [],
      history: rental.auditLogs || [],

      nextDueDate,
      financialSummary: {
        totalPaid,
        totalPending,
        totalOverdue,
        paymentsCount: payments.length,
        paidCount: payments.filter((p: any) => p.status === 'PAGO').length,
        totalExpected: this.decimalToNumber(rental.valorFinal || rental.valorTotalPrevisto),
        depositAmount: this.decimalToNumber(rental.depositAmount),
        depositReceived: this.decimalToNumber(rental.caucaoRecebida),
        depositStatus: rental.statusCaucao || 'PENDENTE',
      },
    };
  }

  private parseDateOnlyToUtcNoon(value: string): Date {
    const raw = String(value || '').trim();
    const datePart = raw.slice(0, 10);

    if (!/^\d{4}-\d{2}-\d{2}$/.test(datePart)) {
      return new Date(NaN);
    }

    return new Date(`${datePart}T12:00:00.000Z`);
  }

  private calculateInstallmentDate(
    startDateStr: string,
    periodIndex: number,
    tipoCobranca: string,
    diaVencimento: number
  ): string {
    const raw = String(startDateStr || '').trim();
    const datePart = raw.slice(0, 10);

    // Datas de locaÃ§Ã£o sÃ£o DATE-ONLY.
    // Nunca usamos new Date("YYYY-MM-DD"), pois no Brasil
    // isso pode voltar um dia ao converter para UTC.
    if (!/^\d{4}-\d{2}-\d{2}$/.test(datePart)) {
      return new Date().toISOString().slice(0, 10);
    }

    const [year, month, day] = datePart.split('-').map(Number);

    // Trabalhamos em UTC para eliminar completamente o efeito do fuso.
    const date = new Date(Date.UTC(year, month - 1, day, 12, 0, 0));

    const frequency = String(tipoCobranca || '').toUpperCase();

    if (frequency === 'DIARIA') {
      date.setUTCDate(date.getUTCDate() + periodIndex);
    } else if (frequency === 'SEMANAL') {
      date.setUTCDate(date.getUTCDate() + periodIndex * 7);
    } else if (frequency === 'QUINZENAL') {
      date.setUTCDate(date.getUTCDate() + periodIndex * 15);
    } else if (frequency === 'MENSAL') {
      const targetDay = diaVencimento || day;

      // Primeiro vai para o mÃªs correto.
      date.setUTCDate(1);
      date.setUTCMonth(date.getUTCMonth() + periodIndex);

      // Ãšltimo dia do mÃªs.
      const lastDayOfMonth = new Date(
        Date.UTC(
          date.getUTCFullYear(),
          date.getUTCMonth() + 1,
          0,
          12,
          0,
          0
        )
      ).getUTCDate();

      date.setUTCDate(
        Math.min(targetDay, lastDayOfMonth)
      );
    }

    return date.toISOString().slice(0, 10);
  }

  private async updateOverduePayments(companyId: string): Promise<void> {
    const today = new Date().toISOString().split('T')[0];

    await prisma.rentalPayment.updateMany({
      where: {
        tenantId: companyId,
        status: 'PENDENTE',
        dataVencimento: {
          lt: today,
        },
      },
      data: {
        status: 'ATRASADO',
        updatedAt: new Date(),
      },
    });

    await prisma.rentalPayment.updateMany({
      where: {
        tenantId: companyId,
        status: 'ATRASADO',
        dataVencimento: {
          gte: today,
        },
      },
      data: {
        status: 'PENDENTE',
        updatedAt: new Date(),
      },
    });
  }

  private async generateContractNumber(
    tx: Prisma.TransactionClient,
    companyId: string,
    year: number
  ): Promise<string> {
    /*
     * Garante que duas locações da mesma empresa/ano não
     * recebam o mesmo número quando criadas simultaneamente.
     *
     * O lock é válido somente durante esta transação.
     */
    await tx.$queryRaw`
      SELECT pg_advisory_xact_lock(
        hashtextextended(
          ${`RENTAL_NUMBER:${companyId}:${year}`},
          0
        )
      )
    `;

    const rentals = await tx.rental.findMany({
      where: {
        companyId,
        rentalNumber: {
          startsWith: `LOC-${year}-`,
        },
      },
      select: {
        rentalNumber: true,
      },
      orderBy: {
        rentalNumber: 'desc',
      },
      take: 1,
    });

    let sequence = 1;

    if (rentals[0]?.rentalNumber) {
      const match = rentals[0].rentalNumber.match(/-(\d+)$/);

      if (match) {
        sequence = Number(match[1]) + 1;
      }
    }

    return `LOC-${year}-${String(sequence).padStart(6, '0')}`;
  }

  /**
   * GET /api/rentals
   */
  async list(
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
  ): Promise<void> {
    try {
      const companyId = req.user!.companyId;

      if (!companyId) {
        res.status(400).json({
          error: 'COMPANY_REQUIRED',
          message: 'Empresa nÃ£o identificada para esta operaÃ§Ã£o.',
        });
        return;
      }

      const { status, search, clientId, vehicleId, startDate, endDate } =
        req.query;

      await this.updateOverduePayments(companyId);

      const normalizedStatus =
        status && typeof status === 'string'
          ? this.normalizeStatus(status)
          : 'TODAS';

      let prismaStatus: RentalStatus | undefined;

      if (normalizedStatus !== 'TODAS' && normalizedStatus !== 'TODOS') {
        if (normalizedStatus === 'ATRASADA') {
          prismaStatus = undefined;
        } else {
          prismaStatus = this.toPrismaRentalStatus(normalizedStatus);
        }
      }

      const rentals = await prisma.rental.findMany({
        where: {
          companyId,
          ...(prismaStatus ? { status: prismaStatus } : {}),
          ...(clientId && typeof clientId === 'string'
            ? { clientId }
            : {}),
          ...(vehicleId && typeof vehicleId === 'string'
            ? { vehicleId }
            : {}),
          ...(startDate && typeof startDate === 'string'
            ? { startDate: { gte: new Date(startDate) } }
            : {}),
          ...(endDate && typeof endDate === 'string'
            ? { endDate: { lte: new Date(endDate) } }
            : {}),
        },
        include: {
          client: true,
          vehicle: {
            include: {
              mileageLogs: {
                orderBy: { date: 'desc' },
                take: 100,
              },
            },
          },
          rentalPayments: {
            orderBy: {
              numeroParcela: 'asc',
            },
            include: {
              financialTransaction: {
                include: {
                  settlements: {
                    orderBy: {
                      paymentDate: 'asc',
                    },
                  },
                },
              },
            },
          },
          inspections: {
            orderBy: {
              createdAt: 'desc',
            },
          },
        },
        orderBy: {
          createdAt: 'desc',
        },
      });

      let result = rentals.map((rental) => {
        const overdueIds = new Set(
          rental.rentalPayments
            .filter((payment) => payment.status === 'ATRASADO')
            .map((payment) => payment.id)
        );

        return this.formatRental(rental, overdueIds);
      });

      if (normalizedStatus === 'ATRASADA') {
        result = result.filter((rental) => rental.status === 'ATRASADA');
      }

      if (search && typeof search === 'string') {
        const query = search.toUpperCase().trim();

        result = result.filter((rental) => {
          const code = String(rental.codigoContrato || '').toUpperCase();
          const clientName = String(
            rental.client?.name || ''
          ).toUpperCase();
          const plate = String(rental.vehicle?.plate || '').toUpperCase();
          const model = String(rental.vehicle?.model || '').toUpperCase();

          return (
            code.includes(query) ||
            clientName.includes(query) ||
            plate.includes(query) ||
            model.includes(query)
          );
        });
      }

      res.json({
        total: result.length,
        data: result,
      });
    } catch (err) {
      next(err);
    }
  }

  /**
   * GET /api/rentals/:id
   */
  async getById(
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
  ): Promise<void> {
    try {
      const companyId = req.user!.companyId;
      const { id } = req.params;

      await this.updateOverduePayments(companyId);

      const rental = await prisma.rental.findFirst({
        where: {
          companyId,
          OR: [
            { id },
            { rentalNumber: id },
            { codigoContrato: id },
          ],
        },
        include: {
          client: true,
          vehicle: {
            include: {
              mileageLogs: {
                orderBy: { date: 'desc' },
                take: 100,
              },
            },
          },
          rentalPayments: {
            orderBy: {
              numeroParcela: 'asc',
            },
            include: {
              financialTransaction: {
                include: {
                  settlements: {
                    orderBy: {
                      paymentDate: 'asc',
                    },
                  },
                },
              },
            },
          },
          inspections: {
            orderBy: {
              createdAt: 'desc',
            },
          },
        },
      });

      if (!rental) {
        res.status(404).json({
          error: 'RENTAL_NOT_FOUND',
          message: 'LocaÃ§Ã£o nÃ£o encontrada.',
        });
        return;
      }

      const auditLogs = await prisma.auditLog.findMany({
        where: {
          companyId,
          entity: 'RENTAL',
          entityId: rental.id,
        },
        orderBy: {
          createdAt: 'desc',
        },
      });

      const formatted = this.formatRental(
        {
          ...rental,
          auditLogs,
        },
        new Set(
          rental.rentalPayments
            .filter((payment) => payment.status === 'ATRASADO')
            .map((payment) => payment.id)
        )
      );

      res.json({
        data: formatted,
      });
    } catch (err) {
      next(err);
    }
  }

  /**
   * POST /api/rentals
   */
  async create(
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
  ): Promise<void> {
    try {
      const companyId = req.user!.companyId;

      if (!companyId) {
        res.status(400).json({
          error: 'COMPANY_REQUIRED',
          message: 'Empresa nÃ£o identificada para esta operaÃ§Ã£o.',
        });
        return;
      }

      const parsed = rentalSchema.parse(req.body) as any;

      const clientId = parsed.clienteId || parsed.clientId;
      const vehicleId = parsed.veiculoId || parsed.vehicleId;
      const startDate = parsed.dataInicio || parsed.startDate;
      const endDate = parsed.dataFimPrevista || parsed.endDate;

      if (!clientId || !vehicleId || !startDate || !endDate) {
        res.status(400).json({
          error: 'MISSING_FIELDS',
          message:
            'Cliente, veÃ­culo, data de inÃ­cio e data de tÃ©rmino sÃ£o obrigatÃ³rios.',
        });
        return;
      }

      const startDateObj = this.parseDateOnlyToUtcNoon(startDate);
      const endDateObj = this.parseDateOnlyToUtcNoon(endDate);

      if (
        Number.isNaN(startDateObj.getTime()) ||
        Number.isNaN(endDateObj.getTime()) ||
        endDateObj < startDateObj
      ) {
        res.status(400).json({
          error: 'INVALID_DATES',
          message:
            'As datas da locaÃ§Ã£o sÃ£o invÃ¡lidas ou a data de tÃ©rmino Ã© anterior Ã  data de inÃ­cio.',
        });
        return;
      }

      const result = await prisma.$transaction(
        async (tx) => {
        const client = await tx.client.findFirst({
          where: {
            id: clientId,
            companyId,
          },
        });

        if (!client) {
          throw new Error('CLIENT_NOT_FOUND');
        }

        if (!client.active) {
          throw new Error('CLIENT_INACTIVE');
        }

        const vehicle = await tx.vehicle.findFirst({
          where: {
            id: vehicleId,
            companyId,
          },
        });

        if (!vehicle) {
          throw new Error('VEHICLE_NOT_FOUND');
        }

        if (vehicle.status !== 'AVAILABLE') {
          throw new Error('VEHICLE_UNAVAILABLE');
        }


              installmentNumber: i + 1,
              totalInstallments: quantidadePeriodos,
              notes: `GERADO AUTOMATICAMENTE PELA LOCAÃ‡ÃƒO ${rentalNumber}`,
            },
          });
        }

        const vehicleStatus =
          requestedStatus === 'ACTIVE'
            ? 'RENTED'

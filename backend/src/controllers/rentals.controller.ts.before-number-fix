                `LocaÃ§Ã£o ${rentalNumber} - Parcela ${i + 1}/${quantidadePeriodos}`,
              clientId: client.id,
              vehicleId: vehicle.id,
              rentalId: rental.id,
              rentalPaymentId: payment.id,
              grossAmount: amount,
              discountAmount: 0,
              interestAmount: 0,
              netAmount: amount,
              paidAmount: 0,
              remainingAmount: amount,
              competencyDate: startDateObj,
              dueDate: new Date(`${dueDate}T12:00:00`),
              status: paymentStatus === 'ATRASADO'
                ? 'OVERDUE'

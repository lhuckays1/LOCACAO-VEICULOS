                ok: true,
              },
              {
                item: 'PNEUS EM PERFEITAS CONDIÃ‡Ã•ES',
                ok: true,
              },
              {
                item: 'SISTEMA DE FREIOS E LUZES',
                ok: true,
              },
              {
                item: 'AR CONDICIONADO E ACESSÃ“RIOS',
                ok: true,
              },
            ]),
            notes:
              'VISTORIA DE SAÃDA REALIZADA E APROVADA NA ENTREGA DAS CHAVES.',
          },
        });

        await tx.auditLog.create({

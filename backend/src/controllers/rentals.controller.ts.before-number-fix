          await tx.vehicle.update({
            where: {
              id: rental.vehicleId,
            },
            data: {
              status: 'RENTED',
            },
          });
        } else if (targetStatus === 'SCHEDULED') {
          await tx.vehicle.update({
            where: {
              id: rental.vehicleId,
            },
            data: {
              status: 'RESERVED',
            },
          });
        } else if (
          targetStatus === 'CANCELLED' ||
          targetStatus === 'DRAFT'
        ) {
          await tx.vehicle.update({
            where: {
              id: rental.vehicleId,
            },
            data: {
              status: 'AVAILABLE',
            },
          });
        }

        await tx.auditLog.create({
          data: {
            companyId,
            userId: req.user!.userId,
            action: 'STATUS_UPDATE',
            entity: 'RENTAL',
            entityId: rental.id,
            oldData: JSON.stringify({
              status: rental.status,
            }),
            newData: JSON.stringify({
              status: targetStatus,
            }),
          },
        });

        return updatedRental;
      });

      res.json({
        message:
          `Status da locaÃ§Ã£o alterado para ${this.normalizeStatus(
            updated.status
          )}.`,
        data: updated,
      });
    } catch (err) {
      next(err);
    }
  }

  /**
   * POST /api/rentals/:id/payments/:paymentId/pay
   */
  async payPayment(
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
  ): Promise<void> {
    try {
      const companyId = req.user!.companyId;
      const { id, paymentId } = req.params;

      // Mantemos o schema existente para validar forma/data/observaÃ§Ãµes.
      // O valor pago Ã© lido diretamente do body para nÃ£o quebrar versÃµes
      // antigas do payInstallmentSchema que ainda nÃ£o possuem valorPago.
      const parsed = payInstallmentSchema.parse(req.body) as any;

      const rawValorPago = (req.body as any)?.valorPago;
      const hasValorPago =
        rawValorPago !== undefined &&
        rawValorPago !== null &&
        String(rawValorPago).trim() !== '';

      const valorPagoInformado = hasValorPago
        ? Number(rawValorPago)
        : NaN;

      const rawKmAtual = (req.body as any)?.kmAtual;
      const hasKmAtual =
        rawKmAtual !== undefined &&
        rawKmAtual !== null &&
        String(rawKmAtual).trim() !== '';

      const kmAtualInformado = hasKmAtual
        ? Number(rawKmAtual)
        : NaN;

      if (hasValorPago && (!Number.isFinite(valorPagoInformado) || valorPagoInformado <= 0)) {
        res.status(400).json({
          error: 'INVALID_PAYMENT_AMOUNT',
          message: 'O valor pago deve ser maior que zero.',
        });
        return;
      }

      if (
        hasKmAtual &&
        (!Number.isFinite(kmAtualInformado) ||
          !Number.isInteger(kmAtualInformado) ||
          kmAtualInformado < 0)
      ) {
        res.status(400).json({
          error: 'INVALID_CURRENT_MILEAGE',
          message: 'A quilometragem atual deve ser um nÃºmero inteiro vÃ¡lido.',
        });
        return;
      }

      const rental = await prisma.rental.findFirst({
        where: {
          companyId,
          OR: [
            { id },
            { rentalNumber: id },
            { codigoContrato: id },
          ],
        },
        include: {
          vehicle: {
            select: {
              id: true,
              currentMileage: true,
            },
          },
        },
      });

      if (!rental) {
        res.status(404).json({
          error: 'RENTAL_NOT_FOUND',
          message: 'LocaÃ§Ã£o nÃ£o encontrada.',
        });
        return;
      }

      const payment = await prisma.rentalPayment.findFirst({
        where: {
          id: paymentId,
          rentalId: rental.id,
          tenantId: companyId,
        },
        include: {
          financialTransaction: {
            include: {
              settlements: {
                orderBy: {
                  paymentDate: 'asc',
                },
              },
            },
          },
        },
      });

      if (!payment) {
        res.status(404).json({
          error: 'PAYMENT_NOT_FOUND',
          message: 'Parcela de cobranÃ§a nÃ£o encontrada.',
        });
        return;
      }

      if (payment.status === 'CANCELADO') {
        res.status(400).json({
          error: 'PAYMENT_CANCELLED',
          message: 'Esta parcela estÃ¡ cancelada e nÃ£o pode receber pagamento.',
        });
        return;
      }

      const transaction = payment.financialTransaction;

      if (!transaction) {
        res.status(409).json({
          error: 'FINANCIAL_TRANSACTION_NOT_FOUND',
          message:
            'A parcela nÃ£o possui lanÃ§amento financeiro vinculado. Regularize o lanÃ§amento antes de registrar o recebimento.',
        });
        return;
      }

      const now = new Date();
      const paymentDate =
        parsed.dataPagamento ||
        now.toISOString().split('T')[0];

      const paymentDateObj = new Date(`${paymentDate}T12:00:00`);

      if (Number.isNaN(paymentDateObj.getTime())) {
        res.status(400).json({
          error: 'INVALID_PAYMENT_DATE',
          message: 'A data de pagamento informada Ã© invÃ¡lida.',
        });
        return;
      }

      const paymentMethod = this.toPaymentMethod(
        parsed.formaPagamento
      );

      const settings = await prisma.billingSettings.findUnique({
        where: {
          companyId,
        },
      });

      const gracePeriodDays = Math.max(
        0,
        Number(settings?.gracePeriodDays ?? 5)
      );

      const interestEnabled = settings?.interestEnabled ?? true;
      const interestType = settings?.interestType ?? 'MONTHLY';
      const interestRate = Number(settings?.interestRate ?? 0);

      const fineEnabled = settings?.fineEnabled ?? true;
      const fineRate = Number(settings?.fineRate ?? 0);
      const fineOnce = settings?.fineOnce ?? true;

      const originalAmount = Number(transaction.grossAmount);
      const alreadyPaid = Number(transaction.paidAmount || 0);
      const currentRemaining = Math.max(
        0,
        Number(transaction.remainingAmount)
      );

      if (currentRemaining <= 0) {
        res.status(400).json({
          error: 'PAYMENT_ALREADY_SETTLED',
          message: 'Esta parcela jÃ¡ estÃ¡ totalmente quitada.',
        });
        return;
      }

      const amountRequested = hasValorPago
        ? valorPagoInformado
        : currentRemaining;

      if (amountRequested > currentRemaining + 0.005) {
        res.status(400).json({
          error: 'PAYMENT_EXCEEDS_BALANCE',
          message:
            `O valor informado (R$ ${amountRequested.toFixed(2)}) ` +
            `Ã© maior que o saldo atual da parcela (R$ ${currentRemaining.toFixed(2)}).`,
        });
        return;
      }

      const dueDateObj = new Date(`${payment.dataVencimento}T12:00:00`);

      const startOfPayment = new Date(
        paymentDateObj.getFullYear(),
        paymentDateObj.getMonth(),
        paymentDateObj.getDate()
      );

      const startOfDue = new Date(
        dueDateObj.getFullYear(),
        dueDateObj.getMonth(),
        dueDateObj.getDate()
      );

      const diffMs = startOfPayment.getTime() - startOfDue.getTime();
      const daysLate = Math.max(
        0,
        Math.floor(diffMs / (1000 * 60 * 60 * 24))
      );

      const chargeableDays = Math.max(
        0,
        daysLate - gracePeriodDays
      );

      // Os encargos sÃ£o calculados sobre o saldo devedor existente
      // antes deste novo recebimento.
      const baseForCharges = currentRemaining;

      let interest = 0;

      if (
        interestEnabled &&
        interestRate > 0 &&
        chargeableDays > 0 &&
        baseForCharges > 0
      ) {
        if (interestType === 'DAILY') {
          interest =
            baseForCharges *
            (interestRate / 100) *
            chargeableDays;
        } else {
          // Juros mensais: cada perÃ­odo iniciado de 30 dias apÃ³s a carÃªncia.
          const monthsLate = Math.ceil(chargeableDays / 30);
          interest =
            baseForCharges *
            (interestRate / 100) *
            monthsLate;
        }
      }

      interest = Math.round(interest * 100) / 100;

      const alreadyAppliedFine = (transaction.settlements || []).some(
        (settlement: any) => Number(settlement.fine || 0) > 0
      );

      let fine = 0;

      if (
        fineEnabled &&
        fineRate > 0 &&
        chargeableDays > 0 &&
        baseForCharges > 0 &&
        (!fineOnce || !alreadyAppliedFine)
      ) {
        fine =
          baseForCharges *
          (fineRate / 100);

        fine = Math.round(fine * 100) / 100;
      }

      const totalDueBeforePayment =
        Math.round(
          (currentRemaining + interest + fine) * 100
        ) / 100;

      // O valorPago informado representa o valor que o cliente entrega.
      // Se ele informar o valor exato do saldo principal, os encargos
      // continuam compondo o dÃ©bito e o saldo remanescente serÃ¡ preservado.
      //
      // Para quitaÃ§Ã£o integral sem valor informado, cobramos principal +
      // encargos. Para pagamento parcial informado, aplicamos o valor recebido
      // ao dÃ©bito atualizado.
      const requestedCashAmount = hasValorPago
        ? amountRequested
        : totalDueBeforePayment;

      const paidAfter =
        Math.round(
          (alreadyPaid + requestedCashAmount) * 100
        ) / 100;

      const newRemaining =
        Math.round(
          Math.max(
            0,
            totalDueBeforePayment - requestedCashAmount
          ) * 100
        ) / 100;

      const isFullyPaid = newRemaining <= 0.005;

      if (hasKmAtual) {
        const minimumKm = Math.max(
          Number(rental.vehicle?.currentMileage ?? 0),
          Number(rental.initialMileage ?? 0)
        );

        if (kmAtualInformado < minimumKm) {
          res.status(400).json({
            error: 'INVALID_CURRENT_MILEAGE',
            message:
              `A quilometragem informada (${kmAtualInformado} km) nÃ£o pode ser ` +
              `inferior Ã  quilometragem atual do veÃ­culo ou inicial da locaÃ§Ã£o (${minimumKm} km).`,
          });
          return;
        }
      }

      const newPaymentStatus = isFullyPaid
        ? 'PAGO'
        : 'PARCIAL';

      const financialStatus = isFullyPaid
        ? 'PAID'
        : newRemaining > 0 && chargeableDays > 0
          ? 'OVERDUE'
          : 'PARTIAL';

      const updated = await prisma.$transaction(
        async (tx) => {
        const updatedPayment = await tx.rentalPayment.update({
          where: {
            id: payment.id,
          },
          data: {
            status: newPaymentStatus,
            dataPagamento: paymentDate,
            formaPagamento:
              parsed.formaPagamento || 'PIX',
            observacoes: parsed.observacoes
              ? String(parsed.observacoes).toUpperCase()
              : payment.observacoes,
          },
          include: {
            financialTransaction: {
              include: {
                settlements: {
                  orderBy: {
                    paymentDate: 'asc',
                  },
                },
              },
            },
          },
        });

        const updatedTransaction =
          await tx.financialTransaction.update({
            where: {
              id: transaction.id,
            },
            data: {
              paidAmount: paidAfter,
              remainingAmount: newRemaining,
              interestAmount: Math.round(
                (Number(transaction.interestAmount || 0) + interest) * 100
              ) / 100,
              settlementDate: isFullyPaid
                ? paymentDateObj
                : null,
              paymentMethod,
              status: financialStatus,
            },
          });

        await tx.financialSettlement.create({
          data: {
            companyId,
            transactionId: transaction.id,
            amount: requestedCashAmount,
            paymentDate: paymentDateObj,
            paymentMethod,
            interest,
            fine,
            discount: 0,
            userId: req.user!.userId,
            notes:
              `RECEBIMENTO ${isFullyPaid ? 'INTEGRAL' : 'PARCIAL'} - ` +
              `LOCAÃ‡ÃƒO ${rental.rentalNumber} - ` +
              `PARCELA ${payment.numeroParcela}`,
          },
        });

        if (hasKmAtual) {
          const currentVehicle = await tx.vehicle.findUnique({
            where: {
              id: rental.vehicleId,
            },
            select: {
              currentMileage: true,
            },
          });

          const transactionMinimumKm = Math.max(
            Number(currentVehicle?.currentMileage ?? 0),
            Number(rental.initialMileage ?? 0)
          );

          if (kmAtualInformado < transactionMinimumKm) {
            throw new Error(
              `A quilometragem informada (${kmAtualInformado} km) nÃ£o pode ser inferior Ã  quilometragem atual do veÃ­culo (${transactionMinimumKm} km).`
            );
          }

          if (kmAtualInformado > Number(currentVehicle?.currentMileage ?? 0)) {
            await tx.vehicle.update({
              where: {
                id: rental.vehicleId,
              },
              data: {
                currentMileage: kmAtualInformado,
              },
            });
          }

          await tx.vehicleMileage.create({
            data: {
              vehicle: {
                connect: {
                  id: rental.vehicleId,
                },
              },
              mileage: kmAtualInformado,
              date: paymentDateObj,
              type: 'MANUAL',
              notes:
                `KM INFORMADO NO RECEBIMENTO - LOCAÃ‡ÃƒO ${rental.rentalNumber} - ` +
                `PARCELA ${payment.numeroParcela}`,
              createdBy: req.user!.userId,
            },
          });
        }

        await tx.auditLog.create({
          data: {
            companyId,
            userId: req.user!.userId,
            action: 'PAYMENT',
            entity: 'RENTAL_PAYMENT',
            entityId: payment.id,
            oldData: JSON.stringify({
              status: payment.status,
              paidAmount: alreadyPaid,
              remainingAmount: currentRemaining,
            }),
            newData: JSON.stringify({
              status: newPaymentStatus,
              rentalNumber: rental.rentalNumber,
              numeroParcela: payment.numeroParcela,
              valorOriginal: originalAmount,
              valorRecebido: requestedCashAmount,
              juros: interest,
              multa: fine,
              totalAtualizado: totalDueBeforePayment,
              pagoAcumulado: paidAfter,
              saldoRestante: newRemaining,
              formaPagamento:
                parsed.formaPagamento || 'PIX',
              dataPagamento: paymentDate,
              diasAtraso: daysLate,
              diasAposCarencia: chargeableDays,
              kmAtual: hasKmAtual ? kmAtualInformado : null,
            }),
          },
        });

        return {
          updatedPayment,
          updatedTransaction,
        };
      },
      {
        maxWait: 10000,
        timeout: 30000,
      }
    );

      const freshPayment =
        await prisma.rentalPayment.findUnique({
          where: {
            id: payment.id,
          },
          include: {
            financialTransaction: {
              include: {
                settlements: {
                  orderBy: {
                    paymentDate: 'asc',
                  },
                },
              },
            },
          },
        });

      const responsePayment = freshPayment
        ? this.formatPayment(freshPayment)
        : this.formatPayment(updated.updatedPayment);

      res.json({
        message: isFullyPaid
          ? `Parcela ${payment.numeroParcela} quitada com sucesso!`
          : `Pagamento parcial de R$ ${requestedCashAmount.toFixed(2)} registrado com sucesso. Saldo restante: R$ ${newRemaining.toFixed(2)}.`,
        data: responsePayment,
        financial: {
          valorOriginal: originalAmount,
          saldoAnterior: currentRemaining,
          valorRecebido: requestedCashAmount,
          juros: interest,
          multa: fine,
          totalAtualizado: totalDueBeforePayment,
          pagoAcumulado: paidAfter,
          saldoRestante: newRemaining,
          statusParcela: newPaymentStatus,
          statusFinanceiro: financialStatus,
          diasAtraso: daysLate,
          diasAposCarencia: chargeableDays,
          carenciaDias: gracePeriodDays,
          tipoJuros: interestType,
          taxaJuros: interestRate,
          taxaMulta: fineRate,
        },
      });
    } catch (err) {
      next(err);
    }
  }

  /**
   * PATCH /api/rentals/:id/caucao
   */
  async updateCaucao(
    req: AuthenticatedRequest,
    res: Response,
    next: NextFunction
  ): Promise<void> {
    try {
      const companyId = req.user!.companyId;
      const { id } = req.params;
      const parsed = updateCaucaoSchema.parse(req.body) as any;

      const rental = await prisma.rental.findFirst({
        where: {
          companyId,
          OR: [
            { id },
            { rentalNumber: id },
            { codigoContrato: id },
          ],
        },
      });

      if (!rental) {
        res.status(404).json({
          error: 'RENTAL_NOT_FOUND',
          message: 'LocaÃ§Ã£o nÃ£o encontrada.',
        });
        return;
      }

      const updated = await prisma.$transaction(async (tx) => {
        const currentNotes = rental.notes || '';
        const newNotes = parsed.observacoes
          ? `${currentNotes} | CAUÃ‡ÃƒO: ${parsed.observacoes}`
              .trim()
              .toUpperCase()
          : currentNotes;

        const updatedRental = await tx.rental.update({
          where: {
            id: rental.id,
          },
          data: {
            statusCaucao: parsed.statusCaucao,
            caucaoRecebida: Number(parsed.caucaoRecebida),
            notes: newNotes,
          },
        });

        await tx.auditLog.create({
          data: {
            companyId,
            userId: req.user!.userId,
            action: 'UPDATE_DEPOSIT',
            entity: 'RENTAL',
            entityId: rental.id,
            oldData: JSON.stringify({
              statusCaucao: rental.statusCaucao,
              caucaoRecebida: Number(rental.caucaoRecebida),
            }),
            newData: JSON.stringify({
              statusCaucao: parsed.statusCaucao,
              caucaoRecebida: Number(parsed.caucaoRecebida),
            }),
          },
        });

        return updatedRental;
      });

      res.json({
        message:
          `Status da cauÃ§Ã£o atualizado para ${parsed.statusCaucao} ` +
          `(R$ ${Number(parsed.caucaoRecebida).toFixed(2)} recebido).`,
        data: updated,
      });
    } catch (err) {
      next(err);
    }
  }

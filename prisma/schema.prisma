generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model BillingSettings {
  id              String       @id @default(uuid())
  companyId       String       @unique
  gracePeriodDays Int          @default(5)
  interestEnabled Boolean      @default(true)
  interestType    InterestType @default(MONTHLY)
  interestRate    Decimal      @default(0) @db.Decimal(10, 4)
  fineEnabled     Boolean      @default(true)
  fineRate        Decimal      @default(0) @db.Decimal(10, 4)
  fineOnce        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("billing_settings")
}

model Company {
  id                    String                 @id @default(uuid())
  name                  String
  legalName             String
  document              String                 @unique
  phone                 String
  email                 String
  address               String
  city                  String
  state                 String
  zipCode               String
  logo                  String?
  status                CompanyStatus          @default(ACTIVE)
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  auditLogs             AuditLog[]
  billingSettings       BillingSettings?
  clients               Client[]
  contracts             Contract[]
  costCenters           CostCenter[]
  expenses              Expense[]
  financialCategories   FinancialCategory[]
  financialSettlements  FinancialSettlement[]
  financialTransactions FinancialTransaction[]
  fines                 Fine[]
  incidents             Incident[]
  inspections           Inspection[]
  maintenancePlans      MaintenancePlan[]
  maintenances          Maintenance[]
  payments              Payment[]
  recurringTransactions RecurringTransaction[]
  rentals               Rental[]
  suppliers             Supplier[]
  users                 User[]
  vehicles              Vehicle[]
  workshops             Workshop[]

  @@map("companies")
}

model User {
  id                   String                @id @default(uuid())
  companyId            String?
  name                 String
  email                String                @unique
  password             String
  role                 Role                  @default(OPERATOR)
  active               Boolean               @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  auditLogs            AuditLog[]
  financialSettlements FinancialSettlement[]
  permissions          UserPermission[]
  company              Company?              @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([role])
  @@map("users")
}

model Client {
  id                      String                 @id @default(uuid())
  companyId               String
  type                    ClientType             @default(PF)
  name                    String
  cpfCnpj                 String
  rg                      String?
  birthDate               DateTime?
  phone                   String
  whatsapp                String?
  email                   String
  zipCode                 String
  street                  String
  number                  String
  complement              String?
  neighborhood            String
  city                    String
  state                   String
  driverLicense           String?
  driverLicenseCategory   String?
  driverLicenseExpiration DateTime?
  active                  Boolean                @default(true)
  notes                   String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  company                 Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialTransactions   FinancialTransaction[]
  fines                   Fine[]
  incidents               Incident[]
  inspections             Inspection[]
  rentals                 Rental[]

  @@unique([companyId, cpfCnpj])
  @@index([companyId])
  @@map("clients")
}

model Vehicle {
  id                    String                 @id @default(uuid())
  companyId             String
  plate                 String
  brand                 String
  model                 String
  version               String?
  manufactureYear       Int
  modelYear             Int
  color                 String
  fuel                  String
  category              String
  vehicleType           String?
  status                VehicleStatus          @default(AVAILABLE)
  renavam               String?
  chassis               String?
  engine                String?
  currentMileage        Int                    @default(0)
  power                 String?
  displacement          String?
  passengerCapacity     Int?
  purchaseValue         Decimal?               @db.Decimal(10, 2)
  purchaseDate          DateTime?
  dailyRate             Decimal                @db.Decimal(10, 2)
  weeklyRate            Decimal                @db.Decimal(10, 2)
  biweeklyRate          Decimal?               @db.Decimal(10, 2)
  monthlyRate           Decimal                @db.Decimal(10, 2)
  mileageAllowance      Int                    @default(0)
  excessMileageRate     Decimal                @default(0.50) @db.Decimal(10, 2)
  nextMaintenanceDate   DateTime?
  insuranceProvider     String?
  insuranceExpiration   DateTime?
  tracker               String?
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  expenses              Expense[]
  financialTransactions FinancialTransaction[]
  fines                 Fine[]
  incidents             Incident[]
  inspections           Inspection[]
  maintenancePlans      MaintenancePlan[]
  maintenances          Maintenance[]
  rentals               Rental[]
  mileageLogs           VehicleMileage[]
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, plate])
  @@index([companyId])
  @@index([status])
  @@map("vehicles")
}

model VehicleMileage {
  id        String         @id @default(uuid())
  vehicleId String
  mileage   Int
  date      DateTime       @default(now())
  type      MileageLogType @default(MANUAL)
  notes     String?
  createdBy String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  vehicle   Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_mileages")
}

model Rental {
  id                    String                 @id @default(uuid())
  companyId             String
  rentalNumber          String
  codigoContrato        String?
  clientId              String
  vehicleId             String
  startDate             DateTime
  endDate               DateTime
  actualEndDate         DateTime?
  billingFrequency      String
  amount                Decimal                @db.Decimal(10, 2)
  valorPeriodo          Decimal?               @db.Decimal(10, 2)
  dueDay                Int                    @default(5)
  quantidadePeriodos    Int                    @default(1)
  depositAmount         Decimal                @default(0) @db.Decimal(10, 2)
  caucaoRecebida        Decimal                @default(0) @db.Decimal(10, 2)
  statusCaucao          String                 @default("PENDENTE")
  mileageAllowance      Int                    @default(0)
  excessMileageRate     Decimal                @default(0.50) @db.Decimal(10, 2)
  initialMileage        Int                    @default(0)
  finalMileage          Int?
  valorTotalPrevisto    Decimal?               @db.Decimal(10, 2)
  desconto              Decimal                @default(0) @db.Decimal(10, 2)
  acrescimos            Decimal                @default(0) @db.Decimal(10, 2)
  valorFinal            Decimal?               @db.Decimal(10, 2)
  initialFuelLevel      String                 @default("CHEIO (1/1)")
  finalFuelLevel        String?
  status                RentalStatus           @default(ACTIVE)
  notes                 String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  contracts             Contract[]
  financialTransactions FinancialTransaction[]
  inspections           Inspection[]
  payments              Payment[]
  rentalPayments        RentalPayment[]
  client                Client                 @relation(fields: [clientId], references: [id])
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle               Vehicle                @relation(fields: [vehicleId], references: [id])

  @@unique([companyId, rentalNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@map("rentals")
}

model RentalPayment {
  id                   String                @id @default(uuid())
  tenantId             String
  rentalId             String
  numeroParcela        Int
  descricao            String
  valor                Decimal               @db.Decimal(10, 2)
  dataVencimento       String
  dataPagamento        String?
  formaPagamento       String?
  status               String                @default("PENDENTE")
  observacoes          String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  financialTransaction FinancialTransaction?
  rental               Rental                @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([rentalId])
  @@map("rental_payments")
}

model Contract {
  id             String         @id @default(uuid())
  companyId      String
  contractNumber String
  rentalId       String
  status         ContractStatus @default(ACTIVE)
  terms          String
  signedAt       DateTime?
  fileUrl        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  company        Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rental         Rental         @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([rentalId])
  @@map("contracts")
}

model Payment {
  id            String        @id @default(uuid())
  companyId     String
  rentalId      String?
  dueDate       DateTime
  paidDate      DateTime?
  amount        Decimal       @db.Decimal(10, 2)
  paidAmount    Decimal?      @db.Decimal(10, 2)
  paymentMethod String?
  status        PaymentStatus @default(PENDING)
  receiptUrl    String?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rental        Rental?       @relation(fields: [rentalId], references: [id])

  @@index([companyId])
  @@index([rentalId])
  @@index([status])
  @@map("payments")
}

model Expense {
  id          String    @id @default(uuid())
  companyId   String
  vehicleId   String?
  category    String
  description String
  amount      Decimal   @db.Decimal(10, 2)
  date        DateTime  @default(now())
  dueDate     DateTime?
  status      String    @default("PAID")
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])

  @@index([companyId])
  @@index([vehicleId])
  @@map("expenses")
}

model Maintenance {
  id                     String                @id @default(uuid())
  companyId              String
  tenantId               String?
  codigo                 String
  vehicleId              String
  type                   MaintenanceType       @default(PREVENTIVE)
  status                 MaintenanceStatus     @default(SCHEDULED)
  titulo                 String
  descricao              String
  kmEntrada              Int
  kmConclusao            Int?
  dataAgendamento        DateTime
  dataInicio             DateTime?
  dataConclusao          DateTime?
  custoPecas             Decimal               @default(0) @db.Decimal(10, 2)
  custoMaoDeObra         Decimal               @default(0) @db.Decimal(10, 2)
  custoOutros            Decimal               @default(0) @db.Decimal(10, 2)
  custoTotal             Decimal               @default(0) @db.Decimal(10, 2)
  supplierId             String?
  workshopId             String?
  workshop               String?
  financialTransactionId String?               @unique
  observacoes            String?
  createdBy              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  financialTransaction   FinancialTransaction? @relation("MaintenanceToFinancialTransaction")
  parts                  MaintenancePart[]
  services               MaintenanceService[]
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplierRef            Supplier?             @relation(fields: [supplierId], references: [id])
  vehicle                Vehicle               @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  workshopRef            Workshop?             @relation(fields: [workshopId], references: [id])

  @@unique([companyId, codigo])
  @@index([companyId])
  @@index([vehicleId])
  @@index([status])
  @@map("maintenances")
}

model MaintenanceService {
  id            String      @id @default(uuid())
  maintenanceId String
  descricao     String
  quantidade    Decimal     @default(1) @db.Decimal(10, 2)
  valorUnitario Decimal     @db.Decimal(10, 2)
  valorTotal    Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId])
  @@map("maintenance_services")
}

model MaintenancePart {
  id            String      @id @default(uuid())
  maintenanceId String
  nome          String
  codigo        String?
  quantidade    Decimal     @default(1) @db.Decimal(10, 2)
  valorUnitario Decimal     @db.Decimal(10, 2)
  valorTotal    Decimal     @db.Decimal(10, 2)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)

  @@index([maintenanceId])
  @@map("maintenance_parts")
}

model MaintenancePlan {
  id                 String    @id @default(uuid())
  companyId          String
  tenantId           String?
  vehicleId          String?
  nomeServico        String
  descricao          String?
  intervaloKm        Int?
  ultimaKm           Int?
  proximaKm          Int?
  intervaloDias      Int?
  ultimaData         DateTime?
  proximaData        DateTime?
  alertaKmFaltando   Int?      @default(1000)
  alertaDiasFaltando Int?      @default(15)
  status             String    @default("ATIVO")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  company            Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle            Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@map("maintenance_plans")
}

model Workshop {
  id           String        @id @default(uuid())
  companyId    String
  tenantId     String?
  nome         String
  cnpj         String?
  telefone     String
  email        String?
  endereco     String?
  cidade       String?
  uf           String?
  observacoes  String?
  ativo        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  maintenances Maintenance[]
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("workshops")
}

model Supplier {
  id           String        @id @default(uuid())
  companyId    String
  tenantId     String?
  nome         String
  tipo         SupplierType  @default(OFICINA)
  cpfCnpj      String?
  telefone     String
  email        String?
  endereco     String?
  observacoes  String?
  ativo        Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  maintenances Maintenance[]
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("suppliers")
}

model Inspection {
  id         String         @id @default(uuid())
  companyId  String
  rentalId   String?
  vehicleId  String
  clientId   String?
  type       InspectionType @default(CHECKOUT)
  mileage    Int
  fuelLevel  String         @default("FULL")
  notes      String?
  itemsJson  String?
  photosJson String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  client     Client?        @relation(fields: [clientId], references: [id])
  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  rental     Rental?        @relation(fields: [rentalId], references: [id])
  vehicle    Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@map("inspections")
}

model Fine {
  id          String     @id @default(uuid())
  companyId   String
  vehicleId   String
  clientId    String?
  date        DateTime
  location    String
  description String
  amount      Decimal    @db.Decimal(10, 2)
  points      Int        @default(0)
  dueDate     DateTime
  status      FineStatus @default(PENDING)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  client      Client?    @relation(fields: [clientId], references: [id])
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@index([clientId])
  @@map("fines")
}

model Incident {
  id          String         @id @default(uuid())
  companyId   String
  vehicleId   String
  clientId    String?
  type        String
  date        DateTime       @default(now())
  description String
  status      IncidentStatus @default(REPORTED)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  client      Client?        @relation(fields: [clientId], references: [id])
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vehicle     Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([vehicleId])
  @@index([clientId])
  @@map("incidents")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   String?
  newData   String?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([entity])
  @@map("audit_logs")
}

model FinancialCategory {
  id                    String                 @id @default(uuid())
  companyId             String
  name                  String
  type                  FinancialType
  description           String?
  color                 String?                @default("#10B981")
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions          FinancialTransaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([companyId, name, type])
  @@index([companyId])
  @@map("financial_categories")
}

model CostCenter {
  id                    String                 @id @default(uuid())
  companyId             String
  code                  String
  name                  String
  description           String?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions          FinancialTransaction[]
  recurringTransactions RecurringTransaction[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("cost_centers")
}

model FinancialTransaction {
  id                String                @id @default(uuid())
  companyId         String
  type              FinancialType
  origin            FinancialOrigin       @default(OTHER)
  description       String
  categoryId        String?
  costCenterId      String?
  clientId          String?
  vehicleId         String?
  rentalId          String?
  rentalPaymentId   String?               @unique
  maintenanceId     String?               @unique
  recurringId       String?
  grossAmount       Decimal               @db.Decimal(10, 2)
  discountAmount    Decimal               @default(0) @db.Decimal(10, 2)
  interestAmount    Decimal               @default(0) @db.Decimal(10, 2)
  netAmount         Decimal               @db.Decimal(10, 2)
  paidAmount        Decimal               @default(0) @db.Decimal(10, 2)
  remainingAmount   Decimal               @db.Decimal(10, 2)
  competencyDate    DateTime              @default(now())
  dueDate           DateTime
  settlementDate    DateTime?
  paymentMethod     PaymentMethod?
  status            FinancialStatus       @default(PENDING)
  isRecurring       Boolean               @default(false)
  installmentNumber Int?
  totalInstallments Int?
  receiptUrl        String?
  notes             String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  settlements       FinancialSettlement[]
  category          FinancialCategory?    @relation(fields: [categoryId], references: [id])
  client            Client?               @relation(fields: [clientId], references: [id])
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenter        CostCenter?           @relation(fields: [costCenterId], references: [id])
  maintenance       Maintenance?          @relation("MaintenanceToFinancialTransaction", fields: [maintenanceId], references: [id])
  recurring         RecurringTransaction? @relation(fields: [recurringId], references: [id])
  rental            Rental?               @relation(fields: [rentalId], references: [id])
  rentalPayment     RentalPayment?        @relation(fields: [rentalPaymentId], references: [id])
  vehicle           Vehicle?              @relation(fields: [vehicleId], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([status])
  @@index([dueDate])
  @@index([origin])
  @@index([clientId])
  @@index([vehicleId])
  @@index([rentalId])
  @@index([maintenanceId])
  @@map("financial_transactions")
}

model FinancialSettlement {
  id            String               @id @default(uuid())
  companyId     String
  transactionId String
  amount        Decimal              @db.Decimal(10, 2)
  paymentDate   DateTime             @default(now())
  paymentMethod PaymentMethod
  interest      Decimal              @default(0) @db.Decimal(10, 2)
  fine          Decimal              @default(0) @db.Decimal(10, 2)
  discount      Decimal              @default(0) @db.Decimal(10, 2)
  receiptUrl    String?
  notes         String?
  userId        String?
  createdAt     DateTime             @default(now())
  company       Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transaction   FinancialTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  user          User?                @relation(fields: [userId], references: [id])

  @@index([companyId])
  @@index([transactionId])
  @@index([paymentDate])
  @@map("financial_settlements")
}

model RecurringTransaction {
  id                String                 @id @default(uuid())
  companyId         String
  type              FinancialType
  origin            FinancialOrigin        @default(OTHER)
  description       String
  categoryId        String?
  costCenterId      String?
  clientId          String?
  vehicleId         String?
  amount            Decimal                @db.Decimal(10, 2)
  frequency         RecurringFrequency     @default(MENSAL)
  dayOfDue          Int                    @default(10)
  startDate         DateTime
  endDate           DateTime?
  active            Boolean                @default(true)
  lastGeneratedDate DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  transactions      FinancialTransaction[]
  category          FinancialCategory?     @relation(fields: [categoryId], references: [id])
  company           Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  costCenter        CostCenter?            @relation(fields: [costCenterId], references: [id])

  @@index([companyId])
  @@index([active])
  @@map("recurring_transactions")
}

model UserPermission {
  id         String     @id @default(uuid())
  userId     String
  permission Permission
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
  @@index([permission])
  @@map("user_permissions")
}

model PlatformSettings {
  id                     String   @id @default("platform")
  platformName           String   @default("FROTA CONTROL")
  platformShortName      String   @default("FROTA")
  logo                   String?
  supportEmail           String?
  country                String   @default("BR")
  currency               String   @default("BRL")
  timezone               String   @default("America/Sao_Paulo")
  dateFormat             String   @default("DD/MM/YYYY")
  minimumPasswordLength  Int      @default(8)
  requireStrongPassword  Boolean  @default(true)
  sessionDurationMinutes Int      @default(480)
  maintenanceMode        Boolean  @default(false)
  allowRegistration      Boolean  @default(false)
  notificationsEnabled   Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("platform_settings")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  OPERATOR
  FINANCIAL
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClientType {
  PF
  PJ
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  BLOCKED
  SOLD
}

enum MileageLogType {
  RENTAL_START
  RENTAL_END
  MAINTENANCE
  MANUAL
  FUEL
}

enum RentalStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
  OVERDUE
  BLOCKED
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  PARTIAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  EMERGENCY
  INSPECTION
  OIL_CHANGE
  TIRES
  BRAKES
  SUSPENSION
  ELECTRICAL
  ENGINE
  OTHER
}

